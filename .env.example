# Proměnné prostředí pro serverovou funkci rezervace (api/rezervace.js).
# Lokálně je dejte do souboru .env.local (je v .gitignore), na Vercelu do Settings > Environment Variables (Production).
# Skutečné hodnoty se do repozitáře nikdy neukládají.

# Číslo účtu pro platbu semináře ve tvaru [předčíslí-]číslo/kód banky, např. 123456789/0100.
# Z něj se počítá IBAN pro QR platbu (včetně kontrolního součtu) a funkce ho před použitím ověří.
BANK_ACCOUNT=

# Jméno majitele účtu. Do QR platby se převede na velká písmena bez diakritiky a zkrátí na 35 znaků.
BANK_ACCOUNT_HOLDER=

# IČO prodejce (uvádí se v e-mailu účastníkovi).
SELLER_ICO=

# E-mail, na který chodí upozornění na novou rezervaci.
NOTIFY_EMAIL=

# Adresa odesílatele na doméně ověřené v Brevo (SPF, DKIM, DMARC), např. info@ocdmentor.cz.
MAIL_FROM=

# Tajný klíč API z Brevo (SMTP & API > API keys). Nikdy ho nevkládejte do kódu ani do repozitáře.
BREVO_API_KEY=

# --- Nepovinné ---
# Povolené původy požadavků na API, oddělené čárkou. Výchozí: https://ocdmentor.cz,https://www.ocdmentor.cz
# ALLOWED_ORIGINS=

# Základ adresy webu v odkazech v e-mailech. Výchozí: https://ocdmentor.cz
# SITE_URL=

# Jiná adresa pro odesílání e-mailů (jen pro testy s atrapou Brevo, vývojový server ji nastaví sám).
# Výchozí: https://api.brevo.com/v3/smtp/email
# BREVO_API_URL=
