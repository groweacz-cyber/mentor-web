{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "functions": {
    "api/rezervace.js": { "maxDuration": 15, "includeFiles": "data/**" }
  },
  "redirects": [
    {
      "source": "/aplikace/start",
      "destination": "/aplikace",
      "permanent": true
    },
    {
      "source": "/aplikace/zebricek",
      "destination": "/aplikace",
      "permanent": true
    },
    {
      "source": "/en/app/start",
      "destination": "/en/app",
      "permanent": true
    },
    {
      "source": "/en/app/ladder",
      "destination": "/en/app",
      "permanent": true
    },
    {
      "source": "/sk/aplikacia/start",
      "destination": "/sk/aplikacia",
      "permanent": true
    },
    {
      "source": "/sk/aplikacia/rebricek",
      "destination": "/sk/aplikacia",
      "permanent": true
    },
    {
      "source": "/metoda",
      "destination": "/jak-to-probiha",
      "permanent": true
    },
    {
      "source": "/dotaznik",
      "destination": "/kontakt",
      "permanent": true
    },
    {
      "source": "/kviz",
      "destination": "/pro-koho",
      "permanent": true
    },
    {
      "source": "/en/method",
      "destination": "/en/how-it-works",
      "permanent": true
    },
    {
      "source": "/en/questionnaire",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/en/quiz",
      "destination": "/en/who-its-for",
      "permanent": true
    },
    {
      "source": "/sk/metoda",
      "destination": "/sk/ako-to-prebieha",
      "permanent": true
    },
    {
      "source": "/sk/dotaznik",
      "destination": "/sk/kontakt",
      "permanent": true
    },
    {
      "source": "/sk/kviz",
      "destination": "/sk/pre-koho",
      "permanent": true
    },
    {
      "source": "/zasady-ochrany-osobnich-udaju",
      "destination": "/ochrana-osobnich-udaju",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.ocdmentor.cz" }],
      "destination": "https://ocdmentor.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ocdmentor.cz" }],
      "destination": "https://ocdmentor.cz/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mentor-web-delta.vercel.app" }],
      "destination": "https://ocdmentor.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mentor-web-delta.vercel.app" }],
      "destination": "https://ocdmentor.cz/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-MkRWfl3p1g5Vy/AwHRJ4siPZU40wMAhpwtygRQjQyuE=' 'sha256-WdvxGS/Ji/KbCLjJlt5TLMmN6VddBNP3tYt6dHaR3rE=' 'sha256-frYMuQGVB5sz4/D5MEia7CiWTK7n4nTaMrD8QnAr0qA=' https://*.reservanto.cz https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://*.reservanto.cz; img-src 'self' data: https://*.reservanto.cz https://www.facebook.com; font-src 'self' https://*.reservanto.cz; connect-src 'self' https://*.reservanto.cz https://www.facebook.com https://connect.facebook.net; frame-src https://*.reservanto.cz; media-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/js/app/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
